# One Supabase project; common server-side connection and scheduler key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
APP_ORIGIN=https://lunch-node.vercel.app
DEMO_MODE=false
MAINTENANCE_MODE=false

# Headquarters secrets. Operator keys: at least 32 random characters each.
AX_INVITE_CODE=
AX_ADMIN_SECRET=
GLOBAL_INVITE_CODE=
GLOBAL_ADMIN_SECRET=

# Production dates live in DB settings; end_date NULL means no end date.
# Fixed demo dates are in lib/operation.ts.

# Legacy INVITE_CODE/ADMIN_SECRET and AX_SUPABASE_* are supported during rollout.
# Final setup should use the names above; do not add GLOBAL_SUPABASE_*.

# TMT: separate server-only invite and operator settings.
TMT_INVITE_CODE=TMT36
TMT_ADMIN_SECRET=

# DEAL is staged only. Enrollment/jobs stay closed until the confirmed roster and DB are installed.
DEAL_INVITE_CODE=DEAL36
DEAL_ADMIN_SECRET=

# 35 cohort: free-name registration for AX Node, Group Node only.
AX35_INVITE_CODE=AX35
