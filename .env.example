# Server-only secrets. Do not prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
INVITE_CODE=
CRON_SECRET=
# Inclusive weekdays; business time zone is Asia/Seoul.
OPERATION_START=2026-10-22
OPERATION_END=2026-11-30

# Explicit opt-in for the browser-only demonstration. Production should be false.
DEMO_MODE=false
# Optional canonical site origin, e.g. https://lunch.example.com
APP_ORIGIN=

# Separate operator key, at least 32 random characters. Never use the invite code.
ADMIN_SECRET=

# Global uses the SAME Supabase URL and service-role key as AX.
# Set separate invite/operator secrets after applying upgrade-shared-db.sql.
# Leave both empty to keep Global unavailable.
GLOBAL_INVITE_CODE=
GLOBAL_ADMIN_SECRET=
# Optional AX-specific overrides for the legacy variables above:
# AX_SUPABASE_URL=
# AX_SUPABASE_SERVICE_ROLE_KEY=
# AX_INVITE_CODE=
# AX_ADMIN_SECRET=
