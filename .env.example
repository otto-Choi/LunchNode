# One Supabase project; common server-side connection and scheduler key.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=
APP_ORIGIN=https://lunch-node.vercel.app
DEMO_MODE=false
MAINTENANCE_MODE=false

# Headquarters secrets. Operator keys: at least 32 random characters each.
AX_INVITE_CODE=
AX_ADMIN_SECRET=
GLOBAL_INVITE_CODE=
GLOBAL_ADMIN_SECRET=

# Demo dates only. Production dates live in each headquarters settings table.
OPERATION_START=2026-10-22
OPERATION_END=2026-11-30

# Legacy INVITE_CODE/ADMIN_SECRET and AX_SUPABASE_* are supported during rollout.
# Final setup should use the names above; do not add GLOBAL_SUPABASE_*.
